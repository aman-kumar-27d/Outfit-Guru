# ============================================================
# LLM Provider Configuration
# ============================================================

# Which LLM provider to use as the primary backend.
# Supported values: "perplexity" (default) | "claude" | "gemini"
# If the primary fails the server auto-falls back to the next
# configured provider(s) below.
LLM_PROVIDER=perplexity

# ── Perplexity ───────────────────────────────────────────────
PERPLEXITY_API_KEY=your_perplexity_api_key_here
# Perplexity chat completions endpoint (OpenAI-compatible)
API_URL=https://api.perplexity.ai/chat/completions
# Default Perplexity model (e.g. sonar, sonar-pro, sonar-reasoning)
DEFAULT_MODEL=sonar

# ── Anthropic Claude ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Default Claude model (overrides the hard-coded default in claude_client.py)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# ── Google Gemini ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Default Gemini REST base URL
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Default Gemini model
GEMINI_MODEL=gemini-1.5-flash
